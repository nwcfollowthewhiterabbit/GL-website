STORE_PUBLIC_URL=http://localhost:8080
API_PORT=3000
CORS_ALLOWED_ORIGINS=

# Use a unique random value of at least 32 characters on deployed environments.
ADMIN_API_TOKEN=

# Customer email login. Keep disabled until SMTP credentials are configured and tested.
ACCOUNT_LOGIN_ENABLED=false
ACCOUNT_SESSION_SECRET=
ACCOUNT_EMAIL_FROM=Green Leaf Pacific <buy@greenleafpacific.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Local-only shortcut that returns the code in the API response.
ACCOUNT_DEV_LOGIN=false

# Optional allowlisted account for a non-production testing site without email delivery.
# Use only with synthetic ERP customer data and keep the access code out of git.
ACCOUNT_TEST_LOGIN_ENABLED=false
ACCOUNT_TEST_LOGIN_EMAIL=
ACCOUNT_TEST_LOGIN_CODE=

# Westpac-approved Windcave Hosted Payment Page. Keep disabled until UAT credentials
# are installed and the payable ERP document has been confirmed.
PAYMENT_ENABLED=false
PAYMENT_PROVIDER=windcave
PAYMENT_API_BASE_URL=https://uat.windcave.com/api/v1
PAYMENT_API_USERNAME=
PAYMENT_API_KEY=

