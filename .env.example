STORE_PUBLIC_URL=http://localhost:8080
API_PORT=3000
CORS_ALLOWED_ORIGINS=
# allow: silent fallback, warn: fallback plus diagnostics (default), deny: ERP-only responses.
STOREFRONT_FALLBACK_MODE=warn
MONITOR_INTERVAL_SECONDS=60
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_BEARER_TOKEN=

# Use a unique random value of at least 32 characters on deployed environments.
ADMIN_API_TOKEN=

# Customer password login. Password hashes are assigned through the protected admin API.
ACCOUNT_LOGIN_ENABLED=false
ACCOUNT_SESSION_SECRET=
ACCOUNT_TEST_LOGIN_EMAIL=
# Seed-only password for synthetic testing data. Pass it for one command and do not commit it.
ACCOUNT_TEST_PASSWORD=

# Westpac-approved Windcave Hosted Payment Page. Keep disabled until UAT credentials
# are installed and the payable ERP document has been confirmed.
PAYMENT_ENABLED=false
PAYMENT_PROVIDER=windcave
PAYMENT_API_BASE_URL=
PAYMENT_API_USERNAME=
PAYMENT_API_KEY=
PAYMENT_PAYABLE_DOCTYPE=
PAYMENT_AMOUNT_MODE=
PAYMENT_ERP_WRITE_ENABLED=false
ERP_PAYMENT_MODE_OF_PAYMENT=
ERP_PAYMENT_PAID_FROM=
ERP_PAYMENT_PAID_TO=

