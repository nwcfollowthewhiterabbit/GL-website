{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:autonomous-project-foundation:runtime-evidence:1",
  "title": "Runtime operation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation",
    "run_id",
    "environment",
    "target",
    "source_revision",
    "status",
    "started_at",
    "finished_at",
    "checks"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "operation": {
      "enum": [
        "backup",
        "deploy_first_instance",
        "deploy_existing_instance",
        "restore",
        "validate_instance",
        "validate_domain",
        "validate_mvp_e2e",
        "validate_ui_e2e"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "environment": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "target": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "source_revision": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "blocked"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "backup_reference": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "rollback_reference": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "release_reference": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "restore_plan_reference": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "target_precondition_reference": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "test_run_reference": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "cleanup_status": {
      "enum": [
        "completed",
        "not_applicable"
      ]
    },
    "tested_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": ".*\\S.*"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": ".*\\S.*"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked",
              "skipped"
            ]
          },
          "detail": {
            "type": "string",
            "pattern": ".*\\S.*"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path",
          "sha256",
          "size_bytes",
          "contains_secrets",
          "restore_critical"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "pattern": ".*\\S.*"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).*\\S.*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "contains_secrets": {
            "type": "boolean"
          },
          "restore_critical": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "status": {
                  "const": "passed"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "contains": {
              "properties": {
                "status": {
                  "const": "failed"
                }
              },
              "required": [
                "status"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "contains": {
              "properties": {
                "status": {
                  "const": "blocked"
                }
              },
              "required": [
                "status"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "backup"
          },
          "status": {
            "const": "passed"
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "required": [
          "backup_reference",
          "artifacts"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "deploy_first_instance"
          },
          "status": {
            "const": "passed"
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "required": [
          "artifact_digest",
          "release_reference",
          "target_precondition_reference",
          "rollback_reference"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "deploy_existing_instance"
          },
          "status": {
            "const": "passed"
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "required": [
          "artifact_digest",
          "release_reference",
          "backup_reference",
          "rollback_reference"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "restore"
          },
          "status": {
            "const": "passed"
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "required": [
          "backup_reference",
          "restore_plan_reference",
          "rollback_reference"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "validate_instance"
          },
          "status": {
            "const": "passed"
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "required": [
          "test_run_reference"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "validate_domain"
          },
          "status": {
            "const": "passed"
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "required": [
          "test_run_reference",
          "cleanup_status"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "validate_mvp_e2e"
          },
          "status": {
            "const": "passed"
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "required": [
          "test_run_reference",
          "cleanup_status"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "validate_ui_e2e"
          },
          "status": {
            "const": "passed"
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "required": [
          "test_run_reference",
          "tested_roles",
          "cleanup_status"
        ]
      }
    }
  ]
}
